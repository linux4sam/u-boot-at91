/dts-v1/;

#include "../../../dts/upstream/src/riscv/microchip/mpfs.dtsi"
#include "microchip-mpfs095-som.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Microchip PolarFire-SoC Motor Control Kit";
	compatible = "microchip,mpfs-motor-control-kit-base-rtlv2601",
		     "microchip,mpfs-motor-control-kit",
		     "microchip,mpfs095-som", "microchip,mpfs";

	aliases {
		ethernet0 = &mac0;
		serial0 = &mmuart0;
		serial1 = &mmuart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-1 {
			gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			label = "led1";
		};

		led-2 {
			gpios = <&gpio2 1 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
			label = "led2";
		};
	};
};

&gpio2 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&mac0 {
	phy-mode = "rgmii-txid";
	phy-handle = <&phy0>;
	status = "okay";

	phy0: ethernet-phy@1 {
		reg = <1>;
	};
};

&mmuart0 {
	status = "okay";
};

&mmuart1 {
	status = "okay";
};
