/*
 * at91-sam9x75eb-u-boot.dts - Device Tree file for SAM9X75-EB board.
 *
 * Copyright (C) 2022 Microchip Technology Inc. and its subsidiaries
 */

/ {
	ahb {
		bootph-all;

		usb0: gadget@500000 {
			compatible = "microchip,sam9x60-udc";
			reg = <0x500000 0x100000>,
			      <0xf803c000 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <23 IRQ_TYPE_LEVEL_HIGH 2>;
			clocks = <&pmc PMC_TYPE_PERIPHERAL 23>, <&pmc PMC_TYPE_CORE 2>;
			clock-names = "pclk", "hclk";
			assigned-clocks = <&pmc PMC_TYPE_CORE 2>;
			assigned-clock-rates = <480000000>;
			atmel,vbus-gpio = <&pioC 26 GPIO_ACTIVE_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_usba_vbus>;
			status = "okay";
		};

		ohci0: usb@600000 {
			compatible = "atmel,at91rm9200-ohci", "usb-ohci";
			reg = <0x600000 0x100000>;
			interrupts = <22 IRQ_TYPE_LEVEL_HIGH 2>;
			clocks = <&pmc PMC_TYPE_PERIPHERAL 22>, <&pmc PMC_TYPE_PERIPHERAL 22>, <&pmc PMC_TYPE_SYSTEM 27>;
			clock-names = "ohci_clk", "hclk", "uhpck";
			num-ports = <3>;
			atmel,vbus-gpio = <0
					   &pioC 27 GPIO_ACTIVE_HIGH
					   &pioC 29 GPIO_ACTIVE_HIGH>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_usb_default>;
			status = "okay";
		};

		ehci0: usb@700000 {
			compatible = "atmel,at91sam9g45-ehci", "usb-ehci";
			reg = <0x700000 0x100000>;
			interrupts = <22 IRQ_TYPE_LEVEL_HIGH 2>;
			clocks = <&pmc PMC_TYPE_CORE 8>, <&pmc PMC_TYPE_PERIPHERAL 22>;
			clock-names = "usb_clk", "ehci_clk";
			assigned-clocks = <&pmc PMC_TYPE_CORE 8>;
			assigned-clock-rates = <480000000>;
			status = "okay";
		};

		apb {
			bootph-all;

			pinctrl {
				bootph-all;
			};
		};
	};

	chosen {
		bootph-all;
	};
};

&clk32k {
	bootph-all;
};

&dbgu {
	bootph-all;
};

&main_xtal {
	bootph-all;
};

&pinctrl {
	pinctrl_usba_vbus: usba_vbus {
		atmel,pins = <AT91_PIOC 26 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
	};

	pinctrl_usb_default: usb_default {
		atmel,pins = <AT91_PIOC 27 AT91_PERIPH_GPIO AT91_PINCTRL_NONE
		AT91_PIOC 29 AT91_PERIPH_GPIO AT91_PINCTRL_NONE>;
	};
};

&pinctrl_dbgu {
	bootph-all;
};

&pinctrl_sdmmc0_default {
	bootph-all;
};

&pinctrl_macb0_rgmii {
	bootph-all;
};

&pioA {
	bootph-all;
};

&pioB {
	bootph-all;
};

&pit64b0 {
	bootph-all;
};

&pmc {
	bootph-all;
};

&sdmmc0 {
	bootph-all;
};

&slow_xtal {
	bootph-all;
};
